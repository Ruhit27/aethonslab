# Claude API key for Lead Autopilot (get one at console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Groq instead of Claude (used when ANTHROPIC_API_KEY is empty)
GROQ_API_KEY=

# Optional: where each lead is forwarded (n8n / Make / Google Apps Script webhook)
# that logs it to a sheet and notifies you.
LEAD_WEBHOOK_URL=

# Log every contact-form lead to a Google Sheet through Composio.
# Consumer key: Composio dashboard > Settings > Sessions & API Key (starts ck_).
# The sheet's ID is the part of its URL between /d/ and /edit.
COMPOSIO_CONSUMER_KEY=
LEADS_SPREADSHEET_ID=1iG2hOhoRDqMyyzjn0od7YJ8OJXcZ8qsV2OvVKwrYbbQ

# WhatsApp Lead Autopilot (see docs/whatsapp-setup.md)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio WhatsApp Sandbox (quick real-phone test)
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=
